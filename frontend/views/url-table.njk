{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% macro urlTable(urls=[]) %}
  {% set tableRows = [] %}
  {% for item in urls %}

  {# Render a small inline delete form #}
      {% set deleteForm %}
        <form action="/{{ item.alias }}" method="post" style="margin: 0;">
          {{ govukButton({
            text: "Delete",
            classes: "govuk-button--warning govuk-!-margin-bottom-0",
            attributes: {
              "style": "padding: 3px 8px; font-size: 14px;"
            }
          }) }}
        </form>
      {% endset %}

{% set tableRows = (tableRows.push([
      { html: '<a href="' + item.alias + '" class="govuk-link" rel="noopener noreferrer">' + item.alias + '</a>'},
      { html: '<a href="' + item.fullUrl + '" class="govuk-link"  rel="noopener noreferrer">' + item.fullUrl + '</a>' },
      { text: item.createdAtFormatted },
      { html: deleteForm }
    ]), tableRows) %}

  {% endfor %}

  {% if urls and urls.length > 0 %}
    {{ govukTable({
      caption: "List of all active short aliases",
      captionClasses: "govuk-table__caption--s",
      head: [
        { text: "Alias" },
        { text: "Original URL" },
        { text: "Created" },
        { text: "Action"}
      ],
      rows: tableRows
    }) }}
  {% else %}
    <p class="govuk-body">No URL mappings found.</p>
  {% endif %}
{% endmacro %}
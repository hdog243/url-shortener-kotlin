{% extends "govuk/template.njk" %}

{% block head %}
  <link href="/public/stylesheets/main.css" rel="stylesheet">
{% endblock %}

{% block header %}
  {{ govukHeader({
    serviceName: "URL Shortener Service",
    serviceUrl: "/"
  }) }}
{% endblock %}

{% block content %}
  {% block pageContent %}{% endblock %}
{% endblock %}

{% block bodyEnd %}

{
  "name": "gds-express-frontend",
  "version": "1.0.0",
  "scripts": {
    "build:assets": "sass --load-path=node_modules src/scss/main.scss public/stylesheets/main.css --no-source-map",
    "build:js": "cp node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.js public/javascripts/",
    "build": "npm run build:assets && npm run build:js",
    "dev": "npm run build && nodemon app.js",
    "start": "node app.js",
    "test": "jest --detectOpenHandles"
  },
  "devDependencies": {
    "axios-mock-adapter": "^2.1.0",
    "jest": "^30.4.2",
    "sass": "^1.102.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "express": "^5.2.1",
    "govuk-frontend": "^6.4.0",
    "nunjucks": "^3.2.4"
  }
}

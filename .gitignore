# ==========================================
# ☕ Kotlin & Gradle Build Artifacts
# ==========================================
.gradle/
build/
bin/
out/

# Allow Gradle Wrapper binaries
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Compiled class files & Kotlin metadata
*.class
*.klib
*.hprof

# ==========================================
# 🌐 Frontend (Node.js / Express / GOV.UK)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# Frontend build outputs / compiled CSS
frontend/public/stylesheets/*.css.map
frontend/dist/

# ==========================================
# ⚙️ Application & Environment Secrets
# ==========================================
*.env
*.env.*
!.env.example
application-local.conf
application-local.yaml

# ==========================================
# ☁️ HashiCorp Terraform
# ==========================================
